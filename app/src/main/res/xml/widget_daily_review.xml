<?xml version="1.0" encoding="utf-8"?>
<!--
  One cell tall by default. The launcher picks the height, and a widget that
  asks for more than its content needs shows a slab of empty card; it is far
  easier to drag one taller than to notice it is too tall and fix it.
  maxResizeHeight keeps a stray drag from stretching it absurdly.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="60dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="180dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_daily_review_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="com.shahaabapps.twotracks.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
